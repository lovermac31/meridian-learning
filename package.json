{
  "name": "jurassic-english",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "dev:server": "tsx server.ts",
    "build": "node --import tsx scripts/prepare-sample-text.mjs && node scripts/generate-seo-pages-meta.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender-yl-vi.mjs && node --import tsx scripts/prerender-route-metadata.mjs && node --import tsx scripts/generate-sitemap.mjs && node --import tsx scripts/seo/build-html-sitemap.mjs",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "test:metadata": "node --import tsx --test tests/metadata.test.ts",
    "test:testimonials": "node --import tsx --test tests/testimonials.test.ts tests/testimonials-mount.test.ts",
    "validate:prerender": "node --import tsx scripts/validate-prerender-routes.mjs",
    "pricing:access-link": "node scripts/generate-pricing-access-link.mjs",
    "external-portal:access-link": "node --import tsx scripts/generate-external-portal-access-link.mjs",
    "supabase:keepalive": "node --env-file=.env.local scripts/supabase-keepalive.mjs",
    "clean": "rm -rf dist dist-ssr",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser:reserve": "playwright test -c playwright.reserve.config.ts",
    "video:meta": "node --import tsx scripts/generate-video-meta.mjs",
    "samples:text:generate": "node --import tsx scripts/prepare-sample-text.mjs --generate",
    "samples:text:check": "node --import tsx scripts/prepare-sample-text.mjs",
    "verify:asset-links": "node scripts/check-seo-asset-links.mjs",
    "validate:indexability": "node scripts/seo/indexability-check.mjs",
    "validate:crawl": "node scripts/seo/crawl-check.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "test:site-quality": "node scripts/audit-site-quality.mjs",
    "test:browser:payments": "playwright test -c playwright.pay-everywhere.config.ts"
  },
  "dependencies": {
    "@botui/react": "^1.1.5",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "botui": "^1.1.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.16",
    "autoprefixer": "^10.4.21",
    "sass": "^1.98.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
