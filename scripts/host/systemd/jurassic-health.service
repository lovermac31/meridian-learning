# Jurassic English host: daily /api/health (replaces the Vercel cron). Installed to /etc/systemd/system/.
[Unit]
Description=Jurassic English daily health check (Vercel cron replacement)
After=jurassic-staging.service
Wants=jurassic-staging.service
OnFailure=jurassic-health-alert.service

[Service]
Type=oneshot
User=je-app
Group=je-app
EnvironmentFile=/etc/jurassic-staging/app.env
Environment=HEALTH_ALLOW_UNCONFIGURED=1
ExecStart=/usr/local/lib/jurassic/health-check.sh
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
